#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    pid_t child[3];
    int status;
    int i;

    printf("Parent Process PID: %d\n\n", getpid());

    /* Create multiple child processes */
    for (i = 0; i < 3; i++)
    {
        child[i] = fork();

        if (child[i] < 0)
        {
            printf("Fork failed\n");
            exit(1);
        }

        if (child[i] == 0)
        {
            printf("Child %d created. PID = %d\n", i + 1, getpid());

            sleep(i + 1);

            printf("Child %d completed. PID = %d\n", i + 1, getpid());
            exit(0);
        }
    }

    /* wait() - waits for any child */
    printf("\nParent is using wait()...\n");

    pid_t pid = wait(&status);

    printf("wait(): Child with PID %d completed.\n", pid);

    /* waitpid() - waits for specific children */
    printf("\nParent is using waitpid()...\n");

    for (i = 0; i < 2; i++)
    {
        waitpid(child[i], &status, 0);

        printf("waitpid(): Child with PID %d completed.\n",
               child[i]);
    }

    printf("\nAll child processes completed.\n");
    printf("No zombie processes remain.\n");

    return 0;
}
